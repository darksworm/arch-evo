#!/bin/sh
# Adjust hyprsunset from waybar — custom/sunset refreshes on SIGRTMIN+9.
set -eu

case "${1:-status}" in
    up|down) # clamp to 1000-6500 ourselves: the daemon allows up to 20000, and
        # anything past ~6500 reads as "tint off" when scrolling
        cur=$(hyprctl hyprsunset temperature)
        if [ "$1" = up ]; then new=$((cur + 100)); else new=$((cur - 100)); fi
        [ "$new" -gt 6500 ] && new=6500
        [ "$new" -lt 1000 ] && new=1000
        hyprctl hyprsunset temperature "$new" >/dev/null ;;
    reset) # hyprsunset 0.3.3 lacks the `reset` IPC, and restarting the daemon flashes
        # the tint off. Instead, pick the scheduled profile for the current time from
        # the config and set it over IPC.
        sel=$(awk -v now="$(date +%H%M)" '
            /^[[:space:]]*time[[:space:]]*=/        { split($NF, t, ":"); cur = t[1] * 100 + t[2] }
            /^[[:space:]]*temperature[[:space:]]*=/ { val = $NF }
            /^[[:space:]]*identity[[:space:]]*=/    { val = "identity" }
            /}/ && cur != "" { profiles[cur] = val; cur = "" }
            END {
                best = -1; last = -1
                for (p in profiles) {
                    if (p + 0 <= now + 0 && p + 0 > best) best = p + 0
                    if (p + 0 > last) last = p + 0
                }
                if (best == -1) best = last  # before the first profile: yesterday'\''s last applies
                print profiles[best]
            }' "${HOME}/.config/hypr/hyprsunset.conf")
        if [ "$sel" = "identity" ]; then
            hyprctl hyprsunset identity >/dev/null
        else
            hyprctl hyprsunset temperature "$sel" >/dev/null
        fi ;;
    status)
        if ! temp=$(hyprctl hyprsunset temperature 2>/dev/null); then
            printf '{"text":""}'
            exit 0
        fi
        # hyprsunset 0.3.3 has no identity query — any `identity*` IPC message
        # ENABLES identity (kills the tint), so never ask, only show temperature
        printf '{"text":"☀ %sK","tooltip":"hyprsunset: %s K — scroll ±100K, click to reset to schedule"}' "$temp" "$temp"
        exit 0 ;;
esac

pkill -SIGRTMIN+9 waybar || true
