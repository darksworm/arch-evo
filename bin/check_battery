#!/usr/bin/env bash
# Battery warning notifications via mako
set -euo pipefail

WARN_LEVEL=20
CRIT_LEVEL=10

bat_path="/sys/class/power_supply/BAT0"
[[ -d "${bat_path}" ]] || exit 0

level=$(cat "${bat_path}/capacity")
status=$(cat "${bat_path}/status")

if [[ "${status}" == "Discharging" ]]; then
    if [[ ${level} -le ${CRIT_LEVEL} ]]; then
        notify-send -u critical "Battery Critical" "Battery at ${level}% — plug in now!"
    elif [[ ${level} -le ${WARN_LEVEL} ]]; then
        notify-send -u normal "Battery Low" "Battery at ${level}%"
    fi
fi
