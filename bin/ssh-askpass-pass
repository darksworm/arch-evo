#!/usr/bin/env bash
# SSH_ASKPASS helper backed by `pass`.
# With SSH_ASKPASS_REQUIRE=force, ssh routes *every* prompt here, not just
# passphrases, so anything we can't answer from `pass` goes back to the tty.
set -euo pipefail

prompt="${1:-}"

if [[ "$prompt" == *"Enter passphrase for"* ]]; then
    keypath=$(grep -oE '/[^ :"'"'"']+' <<<"$prompt" | head -1)
    if [[ -n "$keypath" ]]; then
        pass show "ssh/$(basename "$keypath")" | head -1
        exit
    fi
fi

printf '%s' "$prompt" >/dev/tty
[[ "$prompt" == *"(yes/no"* ]] || silent=-s
read ${silent:-} -r answer </dev/tty
[[ -n "${silent:-}" ]] && echo >/dev/tty
printf '%s\n' "$answer"
