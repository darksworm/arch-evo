[core]
  editor = /usr/bin/nvim
  pager = delta

[gpg]
  format = ssh

[user]
  name = ilmars
  signingKey = /home/ilmars/.ssh/id_ecdsa.pub

[color]
  diff = auto

[diff]
  tool = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true

[merge]
  conflictStyle = zdiff3

[includeIf "gitdir:/home/ilmars/Dev/penneo/"]
  path = /home/ilmars/Dev/penneo/.gitconfig

[includeIf "gitdir:/home/ilmars/Dev/private/"]
  path = /home/ilmars/Dev/private/.gitconfig

[includeIf "gitdir:/opt/arch/"]
  path = /home/ilmars/Dev/private/.gitconfig
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
