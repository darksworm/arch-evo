#!/usr/bin/env bash
# Toggle between laptop screen and external monitor.
# Safety: never disable the only active monitor.

laptop="eDP-1"

# Get list of active monitors (one name per line)
active=$(hyprctl monitors -j | jq -r '.[].name')
active_count=$(echo "$active" | wc -l)

# Find external monitor (anything that isn't the laptop)
external=$(echo "$active" | grep -v "^${laptop}$" | head -1)

laptop_active=false
echo "$active" | grep -q "^${laptop}$" && laptop_active=true

if $laptop_active && [ -n "$external" ]; then
    # Both active → disable laptop, keep external
    hyprctl eval "hl.monitor({ output = \"$laptop\", disabled = true })"
elif $laptop_active && [ -z "$external" ]; then
    # Only laptop active, no external connected → do nothing safely
    notify-send "Monitor" "No external monitor detected"
elif ! $laptop_active; then
    # Laptop is off (external must be on) → enable laptop, disable external
    hyprctl eval "hl.monitor({ output = \"$laptop\", mode = \"preferred\", position = \"auto\", scale = \"auto\", disabled = false })"
    sleep 0.5
    # Verify laptop came up before disabling external
    if hyprctl monitors -j | jq -r '.[].name' | grep -q "^${laptop}$"; then
        [ -n "$external" ] && hyprctl eval "hl.monitor({ output = \"$external\", disabled = true })"
    else
        notify-send "Monitor" "Failed to enable laptop display — keeping external"
    fi
fi
