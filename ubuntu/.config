#!/usr/bin/env bash
# arch-evo (Ubuntu port): environment configuration
# Sourced by all ubuntu/ install scripts. Configs (conf/) and helper scripts
# (bin/) are shared with the Arch installer; only the install logic differs.

UBUNTU_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(dirname "${UBUNTU_DIR}")"
CONF_DIR="${REPO_DIR}/conf"
BIN_DIR="${REPO_DIR}/bin"
LIB_DIR="${REPO_DIR}/lib"
APPS_DIR="${UBUNTU_DIR}/apps"
UBUNTU_CONF_DIR="${UBUNTU_DIR}/conf"
COMPLETED_DIR="${HOME}/.local/state/arch-evo-ubuntu/completed"

USERNAME="${USERNAME:-$(id -un)}"

# Locally-built or downloaded tools that aren't packaged for Ubuntu
OPT_DIR="${HOME}/.local/opt"
LOCAL_BIN="${HOME}/.local/bin"

# XDG
XDG_CONFIG_HOME="${HOME}/.config"
XDG_DATA_HOME="${HOME}/.local/share"
XDG_CACHE_HOME="${HOME}/.cache"
XDG_STATE_HOME="${HOME}/.local/state"

# Source shared libraries, then Ubuntu-specific helpers
source "${LIB_DIR}/detect.sh"
source "${LIB_DIR}/utils.sh"
source "${LIB_DIR}/dialog.sh"
source "${UBUNTU_DIR}/lib/apt.sh"
